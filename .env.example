# ==============================================================================
# tennis-trading-bot Configuration
# ==============================================================================

# Execution Mode: "paper" (virtual simulation, zero risk) or "kalshi" (real exchange orders)
TRADE_MODE=paper

# Virtual or Account Bankroll (USD) used for fractional Kelly calculation
BANKROLL_USD=1000.0

# Quantitative Strategy Thresholds
# Minimum fee-aware edge in percentage points (e.g. 8.0 = 8.0pp advantage)
MIN_EDGE_PP=8.0

# Maximum allowed bid-ask spread in dollars (e.g. 0.15 = 15 cents)
MAX_SPREAD=0.15

# Confidence band filter: "any", "medium_plus", "high_only"
MIN_CONFIDENCE=medium_plus

# Minimum minutes remaining before match scheduled start
MIN_MINUTES_TO_START=30.0

# Maximum bankroll fraction per single bet (safety ceiling, e.g. 0.05 = 5%)
MAX_STAKE_FRACTION=0.05

# Polling interval in seconds for daemon mode
POLL_INTERVAL_SECONDS=300

# Data Feed URL (Public free feed provided by iPredictSport)
PREDICTIONS_FEED_URL=https://ipredictsport.com/predictions.json

# ==============================================================================
# Kalshi API Credentials (Required ONLY if TRADE_MODE=kalshi)
# ==============================================================================
# Sign up via partner link for fee credits: https://kalshi.com/r/eb2fd257-2bc9-465a-a18c-5e9a0ab4848d
KALSHI_API_KEY_ID=your-kalshi-api-key-id
KALSHI_PRIVATE_KEY_PATH=path/to/your/kalshi_private_key.key

# Use Kalshi Demo environment ("true" for demo-api.kalshi.co, "false" for live)
KALSHI_USE_DEMO=true
